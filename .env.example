# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Secret used to sign admin session cookies and password-reset links.
# Required to enable the /admin panel. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Resend (https://resend.com) API key, used to email "forgot password" reset
# links to admins. Optional — without it, reset links are logged to the
# server console instead of emailed, so the flow still works in local dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Niharika Artist Admin <onboarding@resend.dev>
